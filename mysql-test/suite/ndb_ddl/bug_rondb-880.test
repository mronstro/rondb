# Bug RONDB-880:
#   ndb returns error 'DML count in transaction exceeds config parameter MaxDMLOperationsPerTransaction/MaxNoOfConcurrentOp'
#   under the following circumstances:
#   - A table has a TEXT column
#   - The number of rows greatly exceeds MaxNoOfConcurrentOperations
#   - The TEXT column contains data in each row
#   - The table is ALTERed in a way that cannot be done inplace.

-- source include/have_ndb.inc

# Create data
disable_query_log;
DELIMITER %;
CREATE PROCEDURE insert_data ()
BEGIN
  SET @total= 25000;
  REPEAT
    INSERT INTO t1 VALUES
      (@total * 2,
       @total,
       CONCAT(IF(@total MOD 2, 'abc', 'def'),
              CAST(@total AS CHAR)));
    SET @total= @total -1;
  UNTIL @total = 0 END REPEAT;
END %
DELIMITER ;%
enable_query_log;

# Avoid exhausting operation records, at least in absence of related bugs.
SET ndb_use_transactions= 1;

--echo RONDB-880 reproduction variant 1
CREATE TABLE t1 (a int NOT NULL PRIMARY KEY, b int NOT NULL, c varchar(20)) ENGINE=NDB; CALL insert_data();
# This works no matter if the bug is present
ALTER TABLE t1 MODIFY COLUMN b bigint NOT NULL;
DROP TABLE t1;
CREATE TABLE t1 (a int NOT NULL PRIMARY KEY, b int NOT NULL, c text) ENGINE=NDB; CALL insert_data();
# Altering an identical table except with a text column.
# When bug RONDB-880 is present, the following ALTER TABLE statement produces
# ERROR 1296 (HY000): Got error 261 'DML count in transaction exceeds config parameter MaxDMLOperationsPerTransaction/MaxNoOfConcurrentOp' from NDBCLUSTER
ALTER TABLE t1 MODIFY COLUMN b bigint NOT NULL;
DROP TABLE t1;

