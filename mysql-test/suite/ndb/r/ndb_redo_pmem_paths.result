== 1 == the REDO log files are under FileSystemPathRedoLog
== 1b == ndbinfo shows every log part mapped
SELECT node_id, log_part, ldm_instance, redo_path, files, mapped_bytes,
mem_numa_node, persistence_domain, copy_method <> '' AS copy_method,
test_mode,
barriers + bytes_copied + filler_bytes + lat_samples AS counters,
dirty_shutdown_count
FROM ndbinfo.redo_log_pmem ORDER BY node_id, log_part;
node_id	log_part	ldm_instance	redo_path	files	mapped_bytes	mem_numa_node	persistence_domain	copy_method	test_mode	counters	dirty_shutdown_count
1	0	1	0	4	67108864	NULL	NULL	1	nodax	0	NULL
1	1	2	0	4	67108864	NULL	NULL	1	nodax	0	NULL
1	2	3	0	4	67108864	NULL	NULL	1	nodax	0	NULL
1	3	4	0	4	67108864	NULL	NULL	1	nodax	0	NULL
2	0	1	0	4	67108864	NULL	NULL	1	nodax	0	NULL
2	1	2	0	4	67108864	NULL	NULL	1	nodax	0	NULL
2	2	3	0	4	67108864	NULL	NULL	1	nodax	0	NULL
2	3	4	0	4	67108864	NULL	NULL	1	nodax	0	NULL
CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(255)) ENGINE=NDB;
INSERT INTO t1
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq
WHERE n < 1000)
SELECT n, REPEAT('x', 200) FROM seq;
== 2 == system restart, the REDO log is read there
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1;
COUNT(*)	SUM(LENGTH(b))
1000	200000
INSERT INTO t1 VALUES (1001, 'after system restart');
== 3 == node restart
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1;
COUNT(*)	SUM(LENGTH(b))
1001	200020
== 4 == log part 1 of node 2 moved to FileSystemPath is found there
1
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1;
COUNT(*)	SUM(LENGTH(b))
1001	200020
