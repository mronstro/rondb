#
# Basic ALTER TABLE ADD PARTITION
#
CREATE TABLE t1 (
a int not null,
b int not null,
c int not null,
primary key(a,b))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10),
partition p1 values less than (20),
partition p2 values less than (30));
INSERT into t1 values (1, 1, 1);
INSERT into t1 values (15, 1, 2);
INSERT into t1 values (25, 1, 3);
select * from t1 order by a;
a	b	c
1	1	1
15	1	2
25	1	3
select count(*) as partition_count from information_schema.partitions
where table_schema='test' and table_name='t1';
partition_count
3
Add partition at end
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (40));
select count(*) as partition_count from information_schema.partitions
where table_schema='test' and table_name='t1';
partition_count
4
select * from t1 order by a;
a	b	c
1	1	1
15	1	2
25	1	3
select * from t1 where a=1 and b=1;
a	b	c
1	1	1
select * from t1 where a=15 and b=1;
a	b	c
15	1	2
select * from t1 where a=25 and b=1;
a	b	c
25	1	3
INSERT into t1 values (35, 1, 4);
select * from t1 where a=35 and b=1;
a	b	c
35	1	4
INSERT into t1 values (40, 1, 5);
Got one of the listed errors
Add MAXVALUE partition — rejected for native RANGE COLUMNS
ALTER TABLE t1 ADD PARTITION (PARTITION pmax VALUES LESS THAN (MAXVALUE));
ERROR HY000: The NDB handler only supports 32 bit integers in VALUES
select * from t1 order by a;
a	b	c
1	1	1
15	1	2
25	1	3
35	1	4
ALTER TABLE t1 ADD PARTITION (PARTITION p4 VALUES LESS THAN (50));
select count(*) as partition_count from information_schema.partitions
where table_schema='test' and table_name='t1';
partition_count
5
INSERT into t1 values (45, 1, 5);
select * from t1 where a=45 and b=1;
a	b	c
45	1	5
select * from t1 order by a;
a	b	c
1	1	1
15	1	2
25	1	3
35	1	4
45	1	5
drop table t1;
#
# Basic ALTER TABLE DROP PARTITION
#
MAXVALUE rejected in CREATE TABLE for native RANGE COLUMNS
CREATE TABLE t2 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10),
partition p1 values less than (20),
partition p2 values less than (30),
partition pmax values less than (maxvalue));
ERROR HY000: The NDB handler only supports 32 bit integers in VALUES
CREATE TABLE t2 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10),
partition p1 values less than (20),
partition p2 values less than (30),
partition p3 values less than (100));
INSERT into t2 values (5, 1);
INSERT into t2 values (15, 2);
INSERT into t2 values (25, 3);
INSERT into t2 values (50, 4);
select * from t2 order by a;
a	b
5	1
15	2
25	3
50	4
Drop first partition
ALTER TABLE t2 DROP PARTITION p0;
select count(*) as partition_count from information_schema.partitions
where table_schema='test' and table_name='t2';
partition_count
3
select * from t2 order by a;
a	b
15	2
25	3
50	4
select * from t2 where a=5;
a	b
select * from t2 where a=15;
a	b
15	2
select * from t2 where a=25;
a	b
25	3
select * from t2 where a=50;
a	b
50	4
INSERT into t2 values (18, 5);
select * from t2 where a=18;
a	b
18	5
Drop another partition (now p1 is first)
ALTER TABLE t2 DROP PARTITION p1;
select count(*) as partition_count from information_schema.partitions
where table_schema='test' and table_name='t2';
partition_count
2
select * from t2 order by a;
a	b
25	3
50	4
select * from t2 where a=25;
a	b
25	3
select * from t2 where a=50;
a	b
50	4
drop table t2;
#
# Sequential ADD and DROP PARTITION operations
#
CREATE TABLE t3 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (100),
partition p1 values less than (200),
partition p2 values less than (300));
INSERT into t3 values (50, 1);
INSERT into t3 values (150, 2);
INSERT into t3 values (250, 3);
Step 1: Add partition p3
ALTER TABLE t3 ADD PARTITION (PARTITION p3 VALUES LESS THAN (400));
INSERT into t3 values (350, 4);
select * from t3 order by a;
a	b
50	1
150	2
250	3
350	4
Step 2: Drop first partition
ALTER TABLE t3 DROP PARTITION p0;
select * from t3 order by a;
a	b
150	2
250	3
350	4
Step 3: Add another partition at end
ALTER TABLE t3 ADD PARTITION (PARTITION p4 VALUES LESS THAN (500));
INSERT into t3 values (450, 5);
select * from t3 order by a;
a	b
150	2
250	3
350	4
450	5
Step 4: Drop current first partition
ALTER TABLE t3 DROP PARTITION p1;
select * from t3 order by a;
a	b
250	3
350	4
450	5
Step 5: Add partition at end
ALTER TABLE t3 ADD PARTITION (PARTITION p5 VALUES LESS THAN (1000));
INSERT into t3 values (999, 6);
select * from t3 order by a;
a	b
250	3
350	4
450	5
999	6
select count(*) from t3;
count(*)
4
select * from t3 where a=250;
a	b
250	3
select * from t3 where a=350;
a	b
350	4
select * from t3 where a=450;
a	b
450	5
select * from t3 where a=999;
a	b
999	6
drop table t3;
#
# Data integrity: UPDATE and DELETE after ALTER
#
CREATE TABLE t4 (
a int not null,
b int not null,
c varchar(50),
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10),
partition p1 values less than (20),
partition p2 values less than (30));
INSERT into t4 values (5, 1, 'five');
INSERT into t4 values (15, 2, 'fifteen');
INSERT into t4 values (25, 3, 'twentyfive');
ALTER TABLE t4 ADD PARTITION (PARTITION p3 VALUES LESS THAN (40));
UPDATE t4 SET c = 'updated_five' WHERE a = 5;
select * from t4 where a=5;
a	b	c
5	1	updated_five
DELETE FROM t4 WHERE a = 15;
select * from t4 where a=15;
a	b	c
INSERT into t4 values (35, 4, 'thirtyfive');
UPDATE t4 SET c = 'updated_thirtyfive' WHERE a = 35;
select * from t4 where a=35;
a	b	c
35	4	updated_thirtyfive
select * from t4 order by a;
a	b	c
5	1	updated_five
25	3	twentyfive
35	4	updated_thirtyfive
ALTER TABLE t4 DROP PARTITION p0;
select * from t4 where a=5;
a	b	c
select * from t4 order by a;
a	b	c
25	3	twentyfive
35	4	updated_thirtyfive
UPDATE t4 SET c = 'updated_twentyfive' WHERE a = 25;
DELETE FROM t4 WHERE a = 35;
select * from t4 order by a;
a	b	c
25	3	updated_twentyfive
drop table t4;
#
# Scan pruning after ALTER TABLE ADD PARTITION
#
CREATE TABLE t5 (
a int not null,
b int not null,
c int not null,
primary key(a,b))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10),
partition p1 values less than (20),
partition p2 values less than (30));
INSERT into t5 values (5, 1, 1);
INSERT into t5 values (15, 1, 2);
INSERT into t5 values (25, 1, 3);
Pruned scan before ALTER
select * from t5 where a=5 and b=1;
a	b	c
5	1	1
ndb_scan_count
0
ndb_pruned_scan_count
0
ALTER TABLE t5 ADD PARTITION (PARTITION p3 VALUES LESS THAN (40));
INSERT into t5 values (35, 1, 4);
Full scan after ALTER
select * from t5 order by a;
a	b	c
5	1	1
15	1	2
25	1	3
35	1	4
ndb_scan_count
1
ndb_pruned_scan_count
0
Pruned scan on old partition after ALTER
select * from t5 where a=15 order by a;
a	b	c
15	1	2
ndb_scan_count
1
ndb_pruned_scan_count
1
Pruned scan on new partition after ALTER
select * from t5 where a=35 order by a;
a	b	c
35	1	4
ndb_scan_count
1
ndb_pruned_scan_count
1
drop table t5;
#
# Scan pruning after ALTER TABLE DROP PARTITION
#
CREATE TABLE t6 (
a int not null,
b int not null,
primary key(a,b))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10),
partition p1 values less than (20),
partition p2 values less than (30),
partition p3 values less than (100));
INSERT into t6 values (5, 1);
INSERT into t6 values (15, 1);
INSERT into t6 values (25, 1);
INSERT into t6 values (50, 1);
ALTER TABLE t6 DROP PARTITION p0;
Pruned scan after DROP PARTITION
select * from t6 where a=25 and b=1;
a	b
25	1
ndb_scan_count
0
ndb_pruned_scan_count
0
Full scan after DROP PARTITION
select * from t6 order by a;
a	b
15	1
25	1
50	1
ndb_scan_count
1
ndb_pruned_scan_count
0
drop table t6;
#
# Concurrent DML during ALTER TABLE ADD PARTITION
#
CREATE TABLE t7 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (100),
partition p1 values less than (200),
partition p2 values less than (300));
select count(*) from t7;
count(*)
150
select count(*) from t7;
ALTER TABLE t7 ADD PARTITION (PARTITION p3 VALUES LESS THAN (400));
count(*)
150
INSERT into t7 values (350, 350);
select * from t7 where a=350;
a	b
350	350
select * from t7 where a=350;
a	b
350	350
select count(*) from t7;
count(*)
151
select count(*) from t7;
count(*)
151
drop table t7;
#
# Concurrent DML during ALTER TABLE DROP PARTITION
#
CREATE TABLE t8 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (100),
partition p1 values less than (200),
partition p2 values less than (300),
partition p3 values less than (1000));
INSERT into t8 values (50, 1);
INSERT into t8 values (150, 2);
INSERT into t8 values (250, 3);
INSERT into t8 values (500, 4);
select sum(b) from t8;
ALTER TABLE t8 DROP PARTITION p0;
sum(b)
10
select * from t8 order by a;
a	b
150	2
250	3
500	4
select * from t8 order by a;
a	b
150	2
250	3
500	4
select * from t8 where a=50;
a	b
select * from t8 where a=50;
a	b
drop table t8;
#
# Transactions spanning partitions with ALTER
#
CREATE TABLE t9 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (100),
partition p1 values less than (200),
partition p2 values less than (300));
BEGIN;
INSERT into t9 values (50, 1);
INSERT into t9 values (150, 2);
INSERT into t9 values (250, 3);
COMMIT;
select * from t9 order by a;
a	b
50	1
150	2
250	3
ALTER TABLE t9 ADD PARTITION (PARTITION p3 VALUES LESS THAN (500));
BEGIN;
INSERT into t9 values (350, 4);
UPDATE t9 SET b = 10 WHERE a = 50;
UPDATE t9 SET b = 20 WHERE a = 150;
COMMIT;
select * from t9 order by a;
a	b
50	10
150	20
250	3
350	4
BEGIN;
INSERT into t9 values (400, 5);
DELETE FROM t9 WHERE a = 250;
ROLLBACK;
select * from t9 order by a;
a	b
50	10
150	20
250	3
350	4
drop table t9;
#
# BIGINT partition key with ALTER TABLE
#
CREATE TABLE t10 (
a bigint not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (1000000),
partition p1 values less than (2000000),
partition p2 values less than (3000000));
INSERT into t10 values (500000, 1);
INSERT into t10 values (1500000, 2);
INSERT into t10 values (2500000, 3);
ALTER TABLE t10 ADD PARTITION (PARTITION p3 VALUES LESS THAN (4000000));
INSERT into t10 values (3500000, 4);
select * from t10 order by a;
a	b
500000	1
1500000	2
2500000	3
3500000	4
select * from t10 where a=500000;
a	b
500000	1
select * from t10 where a=3500000;
a	b
3500000	4
ALTER TABLE t10 DROP PARTITION p0;
select * from t10 order by a;
a	b
1500000	2
2500000	3
3500000	4
select * from t10 where a=500000;
a	b
drop table t10;
#
# Error cases
#
CREATE TABLE t11 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10),
partition p1 values less than (20),
partition p2 values less than (30));
ALTER TABLE t11 ADD PARTITION (PARTITION p_bad VALUES LESS THAN (15));
ERROR HY000: VALUES LESS THAN value must be strictly increasing for each partition
ALTER TABLE t11 ADD PARTITION (PARTITION p_bad VALUES LESS THAN (30));
ERROR HY000: VALUES LESS THAN value must be strictly increasing for each partition
INSERT into t11 values (5, 1);
INSERT into t11 values (15, 2);
INSERT into t11 values (25, 3);
Dropping middle partition should be rejected
ALTER TABLE t11 DROP PARTITION p1;
ERROR HY000: ALGORITHM=INPLACE is not supported. Reason: NDB only supports dropping the first partition. Try ALGORITHM=COPY.
Dropping last partition should also be rejected
ALTER TABLE t11 DROP PARTITION p2;
ERROR HY000: ALGORITHM=INPLACE is not supported. Reason: NDB only supports dropping the first partition. Try ALGORITHM=COPY.
Dropping first partition should succeed
ALTER TABLE t11 DROP PARTITION p0;
select count(*) as partition_count from information_schema.partitions
where table_schema='test' and table_name='t11';
partition_count
2
select * from t11 order by a;
a	b
15	2
25	3
select * from t11 where a=5;
a	b
select * from t11 where a=15;
a	b
15	2
select * from t11 where a=25;
a	b
25	3
drop table t11;
#
# Multiple ADD PARTITIONs in one statement
#
CREATE TABLE t12 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10));
INSERT into t12 values (5, 1);
ALTER TABLE t12 ADD PARTITION (
PARTITION p1 VALUES LESS THAN (20),
PARTITION p2 VALUES LESS THAN (30),
PARTITION p3 VALUES LESS THAN (200));
ERROR HY000: Got error 741 'Unsupported alter table' from NDBCLUSTER
ALTER TABLE t12 ADD PARTITION (PARTITION p_1 VALUES LESS THAN (20));
ALTER TABLE t12 ADD PARTITION (PARTITION p_2 VALUES LESS THAN (30));
ALTER TABLE t12 ADD PARTITION (PARTITION p_3 VALUES LESS THAN (200));
select count(*) as partition_count from information_schema.partitions
where table_schema='test' and table_name='t12';
partition_count
4
INSERT into t12 values (15, 2);
INSERT into t12 values (25, 3);
INSERT into t12 values (100, 4);
select * from t12 order by a;
a	b
5	1
15	2
25	3
100	4
select * from t12 where a=5;
a	b
5	1
select * from t12 where a=15;
a	b
15	2
select * from t12 where a=25;
a	b
25	3
select * from t12 where a=100;
a	b
100	4
drop table t12;
#
# SHOW CREATE TABLE after ALTER operations
#
CREATE TABLE t13 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (10),
partition p1 values less than (20));
show create table t13;
Table	Create Table
t13	CREATE TABLE `t13` (
  `a` int NOT NULL,
  `b` int NOT NULL,
  PRIMARY KEY (`a`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50500 PARTITION BY RANGE  COLUMNS(a)
(PARTITION p0 VALUES LESS THAN (10) ENGINE = ndbcluster,
 PARTITION p1 VALUES LESS THAN (20) ENGINE = ndbcluster) */
ALTER TABLE t13 ADD PARTITION (PARTITION p2 VALUES LESS THAN (30));
show create table t13;
Table	Create Table
t13	CREATE TABLE `t13` (
  `a` int NOT NULL,
  `b` int NOT NULL,
  PRIMARY KEY (`a`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50500 PARTITION BY RANGE  COLUMNS(a)
(PARTITION p0 VALUES LESS THAN (10) ENGINE = ndbcluster,
 PARTITION p1 VALUES LESS THAN (20) ENGINE = ndbcluster,
 PARTITION p2 VALUES LESS THAN (30) ENGINE = ndbcluster) */
ALTER TABLE t13 DROP PARTITION p0;
show create table t13;
Table	Create Table
t13	CREATE TABLE `t13` (
  `a` int NOT NULL,
  `b` int NOT NULL,
  PRIMARY KEY (`a`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50500 PARTITION BY RANGE  COLUMNS(a)
(PARTITION p1 VALUES LESS THAN (20) ENGINE = ndbcluster,
 PARTITION p2 VALUES LESS THAN (30) ENGINE = ndbcluster) */
drop table t13;
#
# FragId Uint16 wrap-around test (ERROR_INSERT 7251)
# Forces m_startFid_offset=65532 so 4 partitions get fragIds
# 65532, 65533, 65534, 65535. ADD PARTITION wraps fragId to 0.
#

CREATE TABLE t14 (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p0 values less than (100),
partition p1 values less than (200),
partition p2 values less than (300),
partition p3 values less than (400));

INSERT into t14 values (50, 1);
INSERT into t14 values (150, 2);
INSERT into t14 values (250, 3);
INSERT into t14 values (350, 4);
select * from t14 order by a;
a	b
50	1
150	2
250	3
350	4
select * from t14 where a=50;
a	b
50	1
select * from t14 where a=150;
a	b
150	2
select * from t14 where a=250;
a	b
250	3
select * from t14 where a=350;
a	b
350	4
ADD PARTITION — new fragId wraps to 0
ALTER TABLE t14 ADD PARTITION (PARTITION p4 VALUES LESS THAN (500));
INSERT into t14 values (450, 5);
select * from t14 order by a;
a	b
50	1
150	2
250	3
350	4
450	5
select * from t14 where a=450;
a	b
450	5
DROP PARTITION — m_startFid_offset becomes 65533
ALTER TABLE t14 DROP PARTITION p0;
select * from t14 order by a;
a	b
150	2
250	3
350	4
450	5
select * from t14 where a=50;
a	b
select * from t14 where a=150;
a	b
150	2
select * from t14 where a=450;
a	b
450	5
ADD another partition — fragId = 1
ALTER TABLE t14 ADD PARTITION (PARTITION p5 VALUES LESS THAN (600));
INSERT into t14 values (550, 6);
select * from t14 order by a;
a	b
150	2
250	3
350	4
450	5
550	6
select * from t14 where a=550;
a	b
550	6
DROP 3 more partitions to push m_startFid_offset through 65535 to 0
ALTER TABLE t14 DROP PARTITION p1;
ALTER TABLE t14 DROP PARTITION p2;
ALTER TABLE t14 DROP PARTITION p3;
select * from t14 order by a;
a	b
450	5
550	6
select * from t14 where a=450;
a	b
450	5
select * from t14 where a=550;
a	b
550	6
ADD partition after full wrap — fragId = 2
ALTER TABLE t14 ADD PARTITION (PARTITION p6 VALUES LESS THAN (700));
INSERT into t14 values (650, 7);
select * from t14 order by a;
a	b
450	5
550	6
650	7
select * from t14 where a=650;
a	b
650	7
select count(*) from t14;
count(*)
3
drop table t14;
