CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=NDB;
== 1 == transactions of 1, 3, 3 and 2 write operations
INSERT INTO t1 VALUES (10, 10);
BEGIN;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
COMMIT;
UPDATE t1 SET b = b + 1 WHERE a IN (1, 2, 3);
DELETE FROM t1 WHERE a IN (2, 3);
== 2 == all data nodes stop at once
== 3 == each write has a durable COMMIT and a COMPLETE on each replica
ops 1: 2 COMMITs, 2 durable, 2 COMPLETEs
ops 2: 4 COMMITs, 4 durable, 4 COMPLETEs
ops 3: 6 COMMITs, 6 durable, 6 COMPLETEs
ops 3: 6 COMMITs, 6 durable, 6 COMPLETEs
== 4 == system restart
SELECT * FROM t1 ORDER BY a;
a	b
1	2
10	10
DROP TABLE t1;
