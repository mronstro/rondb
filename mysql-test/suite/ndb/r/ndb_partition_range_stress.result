########################################
# F2. Table with many partitions (48)
########################################
SELECT count(*) AS partition_count FROM information_schema.partitions
WHERE table_schema='test' AND table_name='t_many';
partition_count
48
Verify all rows inserted
SELECT count(*) FROM t_many;
count(*)
48
Full table scan
SELECT * FROM t_many ORDER BY a;
PK lookups across partitions
SELECT * FROM t_many WHERE a=50;
a	b
50	1
SELECT * FROM t_many WHERE a=550;
a	b
550	6
SELECT * FROM t_many WHERE a=2450;
a	b
2450	25
SELECT * FROM t_many WHERE a=4750;
a	b
4750	48
DROP first partition
ALTER TABLE t_many ALGORITHM=INPLACE, DROP PARTITION p1;
Verify after DROP
SELECT count(*) FROM t_many;
count(*)
47
SELECT * FROM t_many WHERE a=50;
a	b
ADD partition at end
ALTER TABLE t_many ALGORITHM=INPLACE,
ADD PARTITION (PARTITION p49 VALUES LESS THAN (5000));
INSERT INTO t_many VALUES (4900, 49);
SELECT * FROM t_many WHERE a=4900;
a	b
4900	49
Final count
SELECT count(*) FROM t_many;
count(*)
48
DROP TABLE t_many;
########################################
# F3. Rapid alternating ADD/DROP (100 cycles)
# Start with 2 partitions, repeatedly: ADD at end, DROP first
########################################
CREATE TABLE t_rapid (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p_0 values less than (100),
partition p_1 values less than (200));
INSERT INTO t_rapid VALUES (50, 0);
INSERT INTO t_rapid VALUES (150, 1);
Running 100 ADD/DROP cycles...
100 cycles complete
Verify partition count is still 2
SELECT count(*) AS partition_count FROM information_schema.partitions
WHERE table_schema='test' AND table_name='t_rapid';
partition_count
2
DELETE FROM t_rapid;
Verify lower bound enforcement
INSERT INTO t_rapid VALUES (50, 999);
Got one of the listed errors
INSERT INTO t_rapid VALUES (-1, 999);
Got one of the listed errors
Beyond last boundary should also fail
INSERT INTO t_rapid VALUES (10200, 999);
Got one of the listed errors
Insert into valid range and verify
INSERT INTO t_rapid VALUES (10110, 1);
INSERT INTO t_rapid VALUES (10190, 2);
SELECT * FROM t_rapid ORDER BY a;
a	b
10110	1
10190	2
DROP TABLE t_rapid;
########################################
# I2. FragId wrap-around with rapid ADD/DROP cycles
# Uses ERROR_INSERT 7251 to force fragIds near 65535
########################################

CREATE TABLE t_wrap_stress (
a int not null,
b int not null,
primary key(a))
engine = ndb
partition by range columns (a)
(partition p_0 values less than (100),
partition p_1 values less than (200),
partition p_2 values less than (300));

INSERT INTO t_wrap_stress VALUES (50, 1);
INSERT INTO t_wrap_stress VALUES (150, 2);
INSERT INTO t_wrap_stress VALUES (250, 3);
Verify initial data
SELECT * FROM t_wrap_stress ORDER BY a;
a	b
50	1
150	2
250	3
Running 10 ADD/DROP cycles to wrap fragIds through 65535 to low numbers...
10 wrap cycles complete
Verify partition count
SELECT count(*) AS partition_count FROM information_schema.partitions
WHERE table_schema='test' AND table_name='t_wrap_stress';
partition_count
3
DELETE FROM t_wrap_stress;
Verify lower bound enforcement
INSERT INTO t_wrap_stress VALUES (50, 999);
Got one of the listed errors
Valid insert
INSERT INTO t_wrap_stress VALUES (1110, 1);
INSERT INTO t_wrap_stress VALUES (1190, 2);
SELECT * FROM t_wrap_stress ORDER BY a;
a	b
1110	1
1190	2
DROP TABLE t_wrap_stress;
