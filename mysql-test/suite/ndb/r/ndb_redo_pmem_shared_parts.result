== 1 == the log parts are shared under a mutex
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, c VARCHAR(100)) ENGINE=NDB;
== 2 == writes with the benchmark switch off
INSERT INTO t1
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq
WHERE n < 500)
SELECT n, n, REPEAT('x', 100) FROM seq;
UPDATE t1 SET b = b + 1;
== 3 == writes with the benchmark switch on
UPDATE t1 SET b = b + 1;
DELETE FROM t1 WHERE a > 400;
INSERT INTO t1
WITH RECURSIVE seq(n) AS (SELECT 401 UNION ALL SELECT n + 1 FROM seq
WHERE n < 500)
SELECT n, n, REPEAT('y', 100) FROM seq;
== 4 == writes with the benchmark switch off again
UPDATE t1 SET b = b + 1 WHERE a <= 100;
SELECT COUNT(*), SUM(b) FROM t1;
COUNT(*)	SUM(b)
500	126150
== 5 == the counters of each log part, printed with the switch on
4
4
== 6 == no persist took less than the delay
4
4
== 7 == every log part reads back through the mapping to its end
4
4
DROP TABLE t1;
