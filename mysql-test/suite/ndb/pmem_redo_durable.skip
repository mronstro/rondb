##############################################################################
#
# RONDB-1150: the tests of the rondb suites that do not run with the REDO
# log in PMEM mode and durable commits (pmem_redo_durable.cnf): those of
# pmem_redo.skip, and below those that fail only with durable commits.
# The suite alias rondb_pmem_durable skips them:
#   ./mtr --suite=rondb_pmem_durable --force --parallel=auto
# One suite by hand:
#   ./mtr --suite=ndb --defaults-extra-file=suite/ndb/pmem_redo_durable.cnf \
#         --skip-test-list=suite/ndb/pmem_redo_durable.skip --force
#
# Format as collections/disabled_ndb.def:
#   <suite>.<test> : RONDB-1150 <comment of at most 80 characters>
#
##############################################################################

@import suite/ndb/pmem_redo.skip

# A node restarted with RedoLogMode=file is refused with __DurableCommits=1
ndb.ndb_redo_pmem_mode_switch : RONDB-1150 RedoLogMode=file with __DurableCommits=1
ndb.ndb_redo_pmem_mode_switch_path : RONDB-1150 RedoLogMode=file with __DurableCommits=1
