--source include/have_ndb.inc

# RONDB-1150 (X3): the GCP-saved ledger of testRestartGci (ndb_gci_ledger)
# on the table variants whose commit path durable commits change apart: a
# unique index (NDBT table I3), READ_BACKUP and fully replicated. After
# each system restart with abort the replicas of every fragment, and of
# the unique index, must also agree. It runs in file mode here, and in
# PMEM mode with:
#   ./mtr --defaults-extra-file=suite/ndb/pmem_redo.cnf ndb.ndb_gci_ledger_tables
# The disk-column variant (D1) runs in autotest (pmem-redo-tests.txt).

# NDBT creates TEST_DB.<table> directly through the NDB API. Keep both
# mysqlds stopped so metadata discovery cannot import the API table;
# on a case-insensitive file system it retries CREATE DATABASE TEST_DB
# after each system restart and fails.
--connect(s2,127.0.0.1,root,,test,$MASTER_MYPORT1,)
--connection default
--echo # Shutting down mysqld 1
--let $mysqld_name=mysqld.1.1
--source include/shutdown_mysqld.inc
--let $expect_mysqld1_file_name= $_expect_file_name

--connection s2
--echo # Shutting down mysqld 2
--let $mysqld_name=mysqld.2.1
--source include/shutdown_mysqld.inc
--let $expect_mysqld2_file_name= $_expect_file_name

let NDBAPITEST_CLEANUP_QUERY=;
let NDBAPITEST_NAME=testRestartGci;

--echo == 1 == a unique index and two ordered indexes (I3)
let NDBAPITEST_ARGS=-n GciLedgerSR -l 1 I3;
--source suite/ndb/include/run_ndbapitest.inc

--echo == 2 == READ_BACKUP
let NDBAPITEST_ARGS=-n GciLedgerSRReadBackup -l 1 T1;
--source suite/ndb/include/run_ndbapitest.inc

--echo == 3 == fully replicated
let NDBAPITEST_ARGS=-n GciLedgerSRFullyReplicated -l 1 T1;
--source suite/ndb/include/run_ndbapitest.inc

--connection default
--echo # Starting mysqld 1
--let $_expect_file_name= $expect_mysqld1_file_name
--let $mysqld_name=mysqld.1.1
--source include/start_mysqld.inc

--connection s2
--echo # Starting mysqld 2
--let $_expect_file_name= $expect_mysqld2_file_name
--let $mysqld_name=mysqld.2.1
--source include/start_mysqld.inc

--connection default
--disconnect s2
