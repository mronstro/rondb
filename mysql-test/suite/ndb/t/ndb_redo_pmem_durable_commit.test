--source include/have_ndb.inc

# RONDB-1150 X4 parts 1 and 2 (impl_next_steps.md §4): with
# DurableCommits=1 every write transaction commits durably. Each of its
# write operations leaves on each replica a COMMIT with CF_DURABLE and the
# transaction's opCount, its number of write operations on logged tables,
# and a COMPLETE with its transid, persistent before the commit is
# acknowledged. The data nodes stop at once, and ndb_redo_log_reader reads
# every REDO file of both.

--source suite/ndb/include/redo_pmem_cluster_dir.inc
let REDO_ROOT=$redo_cluster;

CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=NDB;
let $t1_id = query_get_value(SELECT id FROM ndbinfo.dict_obj_info WHERE fq_name = 'test/def/t1', id, 1);
let TABLE_ID=$t1_id;

--echo == 1 == transactions of 1, 3, 3 and 2 write operations
INSERT INTO t1 VALUES (10, 10);
BEGIN;
INSERT INTO t1 VALUES (1, 1), (2, 2), (3, 3);
COMMIT;
UPDATE t1 SET b = b + 1 WHERE a IN (1, 2, 3);
DELETE FROM t1 WHERE a IN (2, 3);
# The GCP of the last one is saved before the stop
--sleep 2

--echo == 2 == all data nodes stop at once
--exec $NDB_MGM -e "all restart -n -a" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --not-started >> $NDB_TOOLS_OUTPUT

# One line per transaction on t1: the opCount of its COMMITs, how many
# there are on the two replicas, how many are durable, and how many
# COMPLETEs have its transid
--echo == 3 == each write has a durable COMMIT and a COMPLETE on each replica
--perl
  use strict;
  my $reader = $ENV{NDB_REDO_LOG_READER};
  my $table = $ENV{TABLE_ID};
  my (%commits, %durable, %ops, %completes);
  foreach my $node (1, 2) {
    foreach my $part (0 .. 3) {
      my $dir = "$ENV{REDO_ROOT}/ndbd.$node/ndb_${node}_fs/D" .
                (8 + $part) . "/DBLQH";
      my @files = glob("$dir/S*.FragLog");
      die "No REDO files in $dir\n" unless @files;
      foreach my $file (@files) {
        my @out = `$reader $file`;
        die "ndb_redo_log_reader $file failed\n" if $? != 0;
        foreach (@out) {
          if (/ COMMIT table (\d+) .* transid (0x[0-9a-f]+) (0x[0-9a-f]+) ops (\d+)( durable)?/) {
            next if $1 != $table;
            my $t = "$2 $3";
            $commits{$t}++;
            $durable{$t}++ if defined $5;
            $ops{$t}{$4} = 1;
          } elsif (/ COMPLETE transid (0x[0-9a-f]+) (0x[0-9a-f]+)$/) {
            $completes{"$1 $2"}++;
          }
        }
      }
    }
  }
  my @lines;
  foreach my $t (keys %commits) {
    push @lines, sprintf("ops %s: %u COMMITs, %u durable, %u COMPLETEs",
                         join(',', sort keys %{$ops{$t}}), $commits{$t},
                         $durable{$t} || 0, $completes{$t} || 0);
  }
  print "$_\n" foreach sort @lines;
EOF

--echo == 4 == system restart
--exec $NDB_MGM -e "all start" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT
--source include/ndb_not_readonly.inc
SELECT * FROM t1 ORDER BY a;

DROP TABLE t1;
--remove_file $NDB_TOOLS_OUTPUT
