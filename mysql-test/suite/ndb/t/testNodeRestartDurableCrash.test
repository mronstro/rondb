--source include/have_ndb.inc
--source have_ndb_error_insert.inc

# RONDB-1150 X4.14: with durable commits a replica of a transaction's rows
# stops at a point of the commit protocol, and the test program checks
# the outcome that the API gets against the rows, before and after the
# data node restarts:
#  - DurableCrashCommit: its durable COMMIT persistent, before COMMITTED
#    or COMMIT to the next replica (5180); the transaction commits on the
#    replica left.
#  - DurableCrashComplete: its COMPLETE written (not fenced), before the
#    local commit (5181); the transaction commits.
#  - DurableCrashLocalCommit: after the local commit at COMPLETE, before
#    COMPLETE goes on (5182); the transaction commits.

let NDBAPITEST_NAME=testNodeRestart;
let NDBAPITEST_ARGS=-n DurableCrashCommit --records=1000 T1;
--source suite/ndb/include/run_ndbapitest.inc

let NDBAPITEST_NAME=testNodeRestart;
let NDBAPITEST_ARGS=-n DurableCrashComplete --records=1000 T1;
--source suite/ndb/include/run_ndbapitest.inc

let NDBAPITEST_NAME=testNodeRestart;
let NDBAPITEST_ARGS=-n DurableCrashLocalCommit --records=1000 T1;
--source suite/ndb/include/run_ndbapitest.inc

# NDBT creates and drops TEST_DB.T1 directly through the NDB API. A mysqld
# whose metadata change monitor happens to see the table creates the
# database TEST_DB and never removes it, and the check of the test case
# fails. Drop it on both mysqlds: DROP DATABASE IF EXISTS is not
# distributed from a mysqld that does not have the database.
--connect(s2,127.0.0.1,root,,test,$MASTER_MYPORT1,)
--disable_warnings
DROP DATABASE IF EXISTS TEST_DB;
--connection default
DROP DATABASE IF EXISTS TEST_DB;
--enable_warnings
--disconnect s2
