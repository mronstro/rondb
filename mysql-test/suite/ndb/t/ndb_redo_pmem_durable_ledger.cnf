!include ../my.cnf

# RONDB-1150 X5.10: durable commits on the REDO log in PMEM mode on any
# file system; small REDO files, so that the writes cross mbytes and
# files; GCP saves twice a second, so that a durable tail is short.
[cluster_config.1]
RedoLogMode=pmem
__RedoLogPmemTestMode=nodax
__DurableCommits=1
NoOfFragmentLogFiles=5
FragmentLogFileSize=4M
TimeBetweenLocalCheckpoints=6
TimeBetweenGlobalCheckpoints=500
