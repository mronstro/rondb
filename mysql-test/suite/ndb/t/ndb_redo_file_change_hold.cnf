!include ../my.cnf

# Small REDO files, so that a log part gets to the end of a file after at
# most 8 MB; 64 MB per log part, and no LCP on the number of words
# written, so that the REDO log does not force one during the test.
[cluster_config.1]
NoOfFragmentLogFiles=16
FragmentLogFileSize=4M
TimeBetweenLocalCheckpoints=31
