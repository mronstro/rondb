!include ../my.cnf

# RONDB-1150 (recovery plan A5): as ndb_redo_pmem_mode_switch, with the
# REDO log of PMEM mode under the BackupDataDir of each data node, a
# directory that is not FileSystemPath, as on a DAX mount in production.
[cluster_config.1]
RedoLogMode=pmem
__RedoLogPmemTestMode=nodax
NoOfFragmentLogFiles=4
FragmentLogFileSize=16M
StopOnError=0
StartFailRetryDelay=10
MaxStartFailRetries=10

[cluster_config.ndbd.1.1]
FileSystemPathRedoLog=@cluster_config.ndbd.1.1.BackupDataDir

[cluster_config.ndbd.2.1]
FileSystemPathRedoLog=@cluster_config.ndbd.2.1.BackupDataDir
