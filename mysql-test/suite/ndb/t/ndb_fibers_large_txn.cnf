!include suite/ndb/my.cnf

[cluster_config.1]
# RONDB-732 Step 1 (congestion_plan.md): same M=2 fiber packing as
# ndb_fibers.cnf — 2 logical LDM workers on 1 OS LDM thread per node.
ThreadConfig=main={count=1},tc={count=1},ldm={count=2},io={count=1},rep={count=1},recv={count=1},send={count=1}
# Scale-up for large transactions, copied from large_txn.cnf:
DataMemory = 256M
NoOfReplicas = 1
MaxNoOfConcurrentOperations = 512K
NoOfFragmentLogFiles = 16

[ENV]
# Inherited by the ndbmtd processes MTR spawns (see ndb_fibers.cnf).
RONDB_FIBERS_PER_THREAD= 2
