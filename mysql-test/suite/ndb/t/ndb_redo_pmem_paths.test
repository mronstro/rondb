--source include/have_ndb.inc

# A run on a DAX mount (MTR_NDB_PMEM_DIR with pmem_redo_dax.cnf or
# pmem_redo_cxl.cnf) replaces the nodax test mode of this test's .cnf, and
# the BackupDataDir used here is not on the DAX mount.
if ($MTR_NDB_PMEM_DIR) {
  --skip Needs __RedoLogPmemTestMode=nodax and its REDO log off the DAX mount
}

# RONDB-1150: with RedoLogMode=pmem the REDO log files go under
# FileSystemPathRedoLog/ndb_<id>_fs/ (platform plan S3.3), here the
# BackupDataDir of the cluster. __RedoLogPmemTestMode=nodax maps them
# without MAP_SYNC. The other files stay under FileSystemPath.

let $cluster = $MYSQLTEST_VARDIR/mysql_cluster.1;

--echo == 1 == the REDO log files are under FileSystemPathRedoLog
--file_exists $cluster/ndb_1_fs/D8/DBLQH/S0.FragLog
--file_exists $cluster/ndb_1_fs/D8/DBLQH/S3.FragLog
--file_exists $cluster/ndb_2_fs/D8/DBLQH/S0.FragLog
--file_exists $cluster/ndb_2_fs/D9/DBLQH/S0.FragLog
--file_exists $cluster/ndbd.1/ndb_1_fs/D1
--error 1
--file_exists $cluster/ndbd.1/ndb_1_fs/D8
--error 1
--file_exists $cluster/ndbd.2/ndb_2_fs/D8

# ndbinfo.redo_log_pmem: one row per log part with all of its files mapped.
# nodax maps without MAP_SYNC and probes nothing, so the memory NUMA node,
# the persistence domain and the dirty-shutdown count are unknown. The
# NUMA node of the LDM and the copy method depend on the host.
--echo == 1b == ndbinfo shows every log part mapped
SELECT node_id, log_part, ldm_instance, redo_path, files, mapped_bytes,
       mem_numa_node, persistence_domain, copy_method <> '' AS copy_method,
       test_mode,
       barriers > 0 AND bytes_copied > 0 AS persisted,
       dirty_shutdown_count
  FROM ndbinfo.redo_log_pmem ORDER BY node_id, log_part;

CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(255)) ENGINE=NDB;
INSERT INTO t1
  WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq
                            WHERE n < 1000)
  SELECT n, REPEAT('x', 200) FROM seq;

--echo == 2 == system restart, the REDO log is read there
--exec $NDB_MGM -e "all restart -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --not-started >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "all start" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT
--source include/ndb_not_readonly.inc
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1;
INSERT INTO t1 VALUES (1001, 'after system restart');

--echo == 3 == node restart
--exec $NDB_MGM -e "1 restart -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --wait-nodes=1 --not-started >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "1 start" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1;

--echo == 4 == log part 1 of node 2 moved to FileSystemPath is found there
--exec $NDB_MGM -e "2 restart -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --wait-nodes=2 --not-started >> $NDB_TOOLS_OUTPUT
--exec mv $cluster/ndb_2_fs/D9 $cluster/ndbd.2/ndb_2_fs/D9
--exec $NDB_MGM -e "2 start" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT
--exec grep -c "log part 1 were found under FileSystemPath, not under REDO path 0" $cluster/ndbd.2/ndbd.log
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1;
SELECT node_id, log_part, redo_path FROM ndbinfo.redo_log_pmem
  WHERE node_id = 2 ORDER BY log_part;

--echo == 5 == initial node restart puts it back under FileSystemPathRedoLog
--exec $NDB_MGM -e "2 restart -n -i" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --wait-nodes=2 --not-started >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "2 start" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT
--file_exists $cluster/ndb_2_fs/D9/DBLQH/S0.FragLog
--error 1
--file_exists $cluster/ndbd.2/ndb_2_fs/D9
SELECT COUNT(*), SUM(LENGTH(b)) FROM t1;
SELECT node_id, log_part, redo_path FROM ndbinfo.redo_log_pmem
  WHERE node_id = 2 ORDER BY log_part;

DROP TABLE t1;
--remove_file $NDB_TOOLS_OUTPUT
