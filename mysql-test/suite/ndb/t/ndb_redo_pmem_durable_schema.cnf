!include ../my.cnf

# RONDB-1150 X5.9: as ndb_redo_pmem_durable_ledger.cnf, for schema
# changes in the durable tail.
[cluster_config.1]
RedoLogMode=pmem
__RedoLogPmemTestMode=nodax
DurableCommits=1
NoOfFragmentLogFiles=5
FragmentLogFileSize=4M
TimeBetweenLocalCheckpoints=6
TimeBetweenGlobalCheckpoints=500
