!include ../my.cnf

# RONDB-1150 phase 8c: small REDO files, 5 per log part, so that the
# writes before the restarts cross mbytes and files; LCPs all the time,
# so that the tail moves; GCP saves twice a second.
[cluster_config.1]
RedoLogMode=pmem
__RedoLogPmemTestMode=nodax
NoOfFragmentLogFiles=5
FragmentLogFileSize=4M
TimeBetweenLocalCheckpoints=6
TimeBetweenGlobalCheckpoints=500
