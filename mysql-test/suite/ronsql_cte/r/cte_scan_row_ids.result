=== csr-2: the same scan with every group kept: full batches, so the
===        rows of a batch are consecutive groups ===
== Query ==
WITH per_ord AS (
SELECT ord AS k, SUM(grp) AS g, SUM(qty) AS q
FROM csr_ord GROUP BY ord)
SELECT per_ord.k, per_ord.q, o.id, o.qty
FROM per_ord
JOIN csr_ord AS o ON o.id = per_ord.k;

Number of output lines, including header: 100001

