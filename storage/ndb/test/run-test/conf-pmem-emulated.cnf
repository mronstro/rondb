#
# RONDB-1150: the REDO log in PMEM mode on a memmap= device mounted with
# dax=always on each data node host, mapped with MAP_SYNC
# (__RedoLogPmemTestMode=emulated: no persistence domain needed), for the
# lists pmem-redo-tests.txt and pmem-redo-long-tests.txt. The REDO log
# of each data node goes under FileSystemPathRedoLog, in ndb_<node id>_fs;
# set it to the DAX directory of the hosts (implementation plan, recovery
# and tests, section 4.3). Each node needs 6 files of 64 MB per log part.
#   atrt --conf=conf-pmem-emulated.cnf --clusters=.2node \
#        --testcase-file=pmem-redo-tests.txt
#

[atrt]
basedir = CHOOSE_dir
clusters = CHOOSE_clusters
baseport = CHOOSE_baseport
fix-nodeid = 1
mt = 2

[ndb_mgmd]

[client]
protocol=tcp

#
# .2node - two ndbmtd nodes
#

[cluster_config.2node]
ndb_mgmd = CHOOSE_host1
ndbd = CHOOSE_host2,CHOOSE_host3
ndbapi= CHOOSE_host1,,,,

NoOfReplicas = 2
DataMemory = 400M
BackupMemory = 64M
MaxNoOfConcurrentScans = 100
MaxNoOfSavedMessages= 5
SendBufferMemory = 2M
NoOfFragmentLogFiles = 6
FragmentLogFileSize = 64M
CompressedLCP=1
CompressedBackup=1
ODirect=1
MaxNoOfAttributes=2000
Checksum=1
AutomaticThreadConfig=1
AutomaticMemoryConfig=1
NumCPUs=3
TotalMemoryConfig=5500M
MaxNoOfTables=200
MaxNoOfOrderedIndexes=200
MaxNoOfUniqueHashIndexes=200
MaxNoOfTriggers=3000
TransactionDeadlockDetectionTimeout=5000
CrashOnLeakedLcpScannedBit=1

SharedGlobalMemory=350M
DiskPageBufferMemory=256M
InitialLogfileGroup=undo_buffer_size=64M;undofile01.dat:512M;undofile02.dat:512M
InitialTablespace=datafile01.dat:256M;datafile02.dat:256M
TimeBetweenWatchDogCheckInitial=60000

RedoLogMode=pmem
__RedoLogPmemTestMode=emulated
FileSystemPathRedoLog=/mnt/pmem0/atrt

#
# .4node
#

[cluster_config.4node]
ndb_mgmd = CHOOSE_host1
ndbd = CHOOSE_host2,CHOOSE_host3,CHOOSE_host4,CHOOSE_host5
ndbapi= CHOOSE_host1,,,,

NoOfReplicas = 2
IndexMemory = 100M
DataMemory = 500M
BackupMemory = 64M
MaxNoOfConcurrentScans = 100
MaxNoOfSavedMessages= 5
NoOfFragmentLogFiles = 6
FragmentLogFileSize = 64M
ODirect=1
MaxNoOfAttributes=2000
Checksum=1
AutomaticThreadConfig=1
NumCPUs=4
PartitionsPerNode=1

SharedGlobalMemory=256M
DiskPageBufferMemory=256M
InitialLogfileGroup=undo_buffer_size=64M;undofile01.dat:512M;undofile02.dat:512M
InitialTablespace=datafile01.dat:256M;datafile02.dat:256M
TimeBetweenWatchDogCheckInitial=60000
HeartbeatIntervalDbApi=5000
TransactionDeadlockDetectionTimeout=2500

RedoLogMode=pmem
__RedoLogPmemTestMode=emulated
FileSystemPathRedoLog=/mnt/pmem0/atrt
